diff --git a/tests/test_rnnoise.py b/tests/test_rnnoise.py
index a986571..0794d92 100644
--- a/tests/test_rnnoise.py
+++ b/tests/test_rnnoise.py
@@ -414,5 +414,74 @@ class TestPipelineControllerModes(unittest.TestCase):
         self.assertIn("error", result)
 
 
+class TestModeProvenance(unittest.TestCase):
+    """Regression: TranscriptEvent.mode must reflect the actual pipeline mode,
+    not be hardcoded to 'raw'."""
+
+    def _make_scheduler_and_transcriber(self):
+        self.events = []
+        self.transcriber = FakeTranscriber(["hello"])
+        self.scheduler = ASRScheduler(
+            self.transcriber, lambda e: self.events.append(e)
+        )
+        return self.scheduler
+
+    def test_scheduler_start_accepts_mode(self):
+        sched = self._make_scheduler_and_transcriber()
+        sched.start("s1", 0, mode="rnnoise")
+        with sched._lock:
+            self.assertEqual(sched._mode, "rnnoise")
+
+    def test_scheduler_reset_accepts_mode(self):
+        sched = self._make_scheduler_and_transcriber()
+        sched.start("s1", 0, mode="raw")
+        sched.reset("s1", 1, mode="rnnoise")
+        with sched._lock:
+            self.assertEqual(sched._mode, "rnnoise")
+            self.assertEqual(sched._epoch, 1)
+
+    def test_transcript_event_carries_mode(self):
+        sched = self._make_scheduler_and_transcriber()
+        sched.start("s1", 0, mode="rnnoise")
+        frame = make_frame(session_id="s1", epoch=0, seq=0,
+                           sample_start=0, captured_ns=0, sample_rate=48000,
+                           valid_samples=480, pcm=np.ones(480, dtype=np.float32) * 0.5)
+        sched.push_audio(frame)
+        sched._finalize_utterance("test")
+        self.assertEqual(len(self.events), 1)
+        self.assertEqual(self.events[0].mode, "rnnoise")
+
+    def test_raw_mode_stamps_raw(self):
+        sched = self._make_scheduler_and_transcriber()
+        sched.start("s1", 0, mode="raw")
+        frame = make_frame(session_id="s1", epoch=0, seq=0,
+                           sample_start=0, captured_ns=0, sample_rate=48000,
+                           valid_samples=480, pcm=np.ones(480, dtype=np.float32) * 0.5)
+        sched.push_audio(frame)
+        sched._finalize_utterance("test")
+        self.assertEqual(len(self.events), 1)
+        self.assertEqual(self.events[0].mode, "raw")
+
+    def test_mode_switch_updates_event_provenance(self):
+        sched = self._make_scheduler_and_transcriber()
+        sched.start("s1", 0, mode="raw")
+        frame1 = make_frame(session_id="s1", epoch=0, seq=0,
+                            sample_start=0, captured_ns=0, sample_rate=48000,
+                            valid_samples=480, pcm=np.ones(480, dtype=np.float32) * 0.5)
+        sched.push_audio(frame1)
+        sched._finalize_utterance("test")
+        self.assertEqual(self.events[0].mode, "raw")
+
+        sched.reset("s1", 1, mode="rnnoise")
+        frame2 = make_frame(session_id="s1", epoch=1, seq=1,
+                            sample_start=480, captured_ns=10000000, sample_rate=48000,
+                            valid_samples=480, pcm=np.ones(480, dtype=np.float32) * 0.5)
+        sched.push_audio(frame2)
+        sched._finalize_utterance("test")
+        self.assertEqual(len(self.events), 2)
+        self.assertEqual(self.events[1].mode, "rnnoise")
+        self.assertEqual(self.events[1].epoch, 1)
+
+
 if __name__ == "__main__":
     unittest.main()
