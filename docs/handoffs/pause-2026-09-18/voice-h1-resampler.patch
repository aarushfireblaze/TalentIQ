+class BlockingFakeTranscriber:
+    def __init__(self, text="blocked"):
+        self._text = text
+        self.entered = threading.Event()
+        self.release = threading.Event()
+        self._loaded = True
+        self._load_error = None
+        self._call_count = 0
+
+    @property
+    def is_loaded(self):
+        return self._loaded
+    @property
+    def load_error(self):
+        return self._load_error
+
+    def decode(self, pcm):
+        self._call_count += 1
+        self.entered.set()
+        self.release.wait(timeout=2.0)
+        return self._text
+
+
+class TestASRProvenance(unittest.TestCase):
+    def test_concurrent_reset_during_decode_rejects_stale_result(self):
+        transcriber = BlockingFakeTranscriber("stale_text")
+        events = []
+        scheduler = ASRScheduler(transcriber, lambda e: events.append(e))
+        
+        scheduler.start("sess1", 0, "rnnoise")
+        
+        # Push some speech frames
+        for i in range(30):
+            f = make_audio_frame(session_id="sess1", epoch=0, seq=i, sample_start=i*160, amplitude=0.8)
+            scheduler.push_audio(f)
+        
+        # Process them to set _in_speech = True
+        scheduler.run_step()
+        
+        # Push enough silence frames to trigger finalize (0.6s = 60 frames)
+        for i in range(65):
+            f = make_audio_frame(session_id="sess1", epoch=0, seq=30+i, sample_start=(30+i)*160, amplitude=0.0)
+            scheduler.push_audio(f)
+            
+        def run_thread():
+            scheduler.run_step()
+            
+        t = threading.Thread(target=run_thread)
+        t.start()
+        
+        try:
+            # Wait for decode to enter
+            transcriber.entered.wait(timeout=1.0)
+            self.assertTrue(transcriber.entered.is_set())
+            
+            # Concurrently reset the scheduler (e.g. user toggled mode)
+            scheduler.reset("sess1", 1, "raw")
+            scheduler.start("sess1", 1, "raw")
+            
+            # Push valid new-context frames
+            for i in range(50):
+                f = make_audio_frame(session_id="sess1", epoch=1, seq=i, sample_start=20000+i*160, amplitude=0.8)
+                scheduler.push_audio(f)
+                
+            # Release decode
+            transcriber.release.set()
+            t.join(timeout=1.0)
+            
+            # Old result must be rejected (stale)
+            finals = [e for e in events if e.kind == "final"]
+            self.assertEqual(len(finals), 0)
+            
+            # New frames must succeed with original new mode/start_ms
+            transcriber._text = "fresh_text"
+            transcriber.entered.clear()
+            transcriber.release.set() # Don't block the next decode
+            
+            # Flush new frames
+            scheduler.run_step()
+            scheduler.finish()
+            finals = [e for e in events if e.kind == "final"]
+            self.assertEqual(len(finals), 1)
+            self.assertEqual(finals[0].text, "fresh_text")
+            self.assertEqual(finals[0].mode, "raw")
+            self.assertEqual(finals[0].epoch, 1)
+            self.assertEqual(finals[0].start_ms, 20000 * 1000.0 / 48000.0)
+            
+        finally:
+            transcriber.release.set()
+            t.join(timeout=1.0)
+
+    def test_mixed_stale_frames_rejected_before_ingestion(self):
+        transcriber = FakeTranscriber(["fresh_text"])
+        events = []
+        scheduler = ASRScheduler(transcriber, lambda e: events.append(e))
+        
+        scheduler.start("sess2", 2, "rnnoise")
+        
+        # Interleave stale frames from old session/epoch with fresh frames
+        for i in range(100):
+            if i % 2 == 0:
+                f = make_audio_frame(session_id="sess1", epoch=1, seq=i, sample_start=i*160, amplitude=0.8) # Stale
+            else:
+                f = make_audio_frame(session_id="sess2", epoch=2, seq=i, sample_start=i*160, amplitude=0.8) # Fresh
+            scheduler.push_audio(f)
+            
+        scheduler.run_step()
+        scheduler.finish()
+        
+        finals = [e for e in events if e.kind == "final"]
+        self.assertEqual(len(finals), 1)
+        self.assertEqual(finals[0].text, "fresh_text")
+        self.assertEqual(finals[0].session_id, "sess2")
+        self.assertEqual(finals[0].epoch, 2)
+        # Fresh frames start at index 1, so sample_start is 160
+        self.assertEqual(finals[0].start_ms, 160 * 1000.0 / 48000.0)
+
 if __name__ == "__main__":
     unittest.main()
